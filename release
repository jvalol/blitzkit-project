#!/usr/bin/env bash
# Cut a release of the engine: ./release 0.13.0
#
# This was five numbered steps in RELEASING.md and fifteen repos, done by hand,
# and the order of them is not obvious from the outside. It matters twice over.
# Publishing before the commit puts a version on crates.io corresponding to
# nothing, which 0.8.3 did for a few minutes. Pushing the games before the
# publish leaves a window where a clone of any of them asks for a version that
# does not exist yet.
#
# So the order is here rather than in anyone's head, and the only thing it asks
# of you is one yes before the upload, because that part cannot be taken back.
set -euo pipefail
cd "$(dirname "$0")"

want=${1:-}
if [ -z "$want" ]; then
  echo "usage: ./release <version>, as in ./release 0.13.0" >&2
  exit 2
fi
if ! printf '%s' "$want" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
  echo "'$want' is not a version" >&2
  exit 2
fi

say() { printf '\n== %s\n' "$*"; }

have=$(grep -m1 '^version = ' blitzkit/Cargo.toml | cut -d'"' -f2)
if [ "$have" = "$want" ]; then
  echo "blitzkit already says $want" >&2
  exit 2
fi

# The minor is what a game's manifest names, so it only edits them when it moves.
minor_now=$(printf '%s' "$have" | cut -d. -f1-2)
minor_want=$(printf '%s' "$want" | cut -d. -f1-2)

repos=()
while read -r repo; do repos+=("$repo"); done < <(./list-repos all | grep -v 'shapes')

say "where everything stands"
dirty=()
for repo in "." "${repos[@]}"; do
  [ -n "$(git -C "$repo" status --porcelain)" ] && dirty+=("$repo")
  if [ "$(git -C "$repo" rev-parse HEAD)" != "$(git -C "$repo" rev-parse @{u} 2>/dev/null)" ]; then
    dirty+=("$repo (not level with its remote)")
  fi
done
if [ ${#dirty[@]} -ne 0 ]; then
  echo "a release starts from a clean tree. These are not:" >&2
  printf '  %s\n' "${dirty[@]}" >&2
  exit 1
fi
echo "all clean and level"

say "$have to $want"
sed -i '' "s/^version = \"$have\"\$/version = \"$want\"/" blitzkit/Cargo.toml
if [ "$minor_now" != "$minor_want" ]; then
  for repo in "${repos[@]}"; do
    [ "$repo" = "blitzkit" ] && continue
    sed -i '' "s/^blitzkit = \"$minor_now\"\$/blitzkit = \"$minor_want\"/" "$repo/Cargo.toml"
  done
  echo "and every manifest from $minor_now to $minor_want, because the minor moved"
else
  echo "the manifests name $minor_now and need no edit"
fi

say "the gate"
./check-all

say "committing the bump"
(cd blitzkit && git commit -q -m "$want" -- Cargo.toml)
if [ "$minor_now" != "$minor_want" ]; then
  for repo in "${repos[@]}"; do
    [ "$repo" = "blitzkit" ] && continue
    (cd "$repo" && git commit -q -m "blitzkit $want" -- Cargo.toml)
  done
fi
echo "committed, pushed nowhere yet"

say "the lockfiles and the pictures"
# Above the prompt, because a lockfile in here records what is on disk rather
# than what crates.io holds, and the bump put $want on disk a moment ago. It
# was below the publish for 0.14.0 and that is what left the browser builds
# stale: these commits are in the repos the builds are made from, so a build
# rebuilt before them goes out of date the moment they land.
#
# refresh-screenshots photographs real windows and is the flakiest thing in
# this file, which is another reason it belongs on this side of the line.
./refresh-screenshots
for repo in "${repos[@]}"; do
  [ "$repo" = "blitzkit" ] && continue
  (cd "$repo" && git add -A Cargo.lock media 2>/dev/null || true)
  if [ -n "$(git -C "$repo" diff --cached --name-only)" ]; then
    (cd "$repo" && git commit -q -m "Lock blitzkit $want, and the picture that goes with it")
  fi
done
echo "committed in each game, pushed nowhere yet"

# **And everything committed so far just made the browser builds stale.** A
# game's manifest, its lockfile and its screenshot all live in the repo its
# build is made from, so committing them puts every game that has a browser
# build behind it. The engine's pre-push refuses on exactly that, and refuses
# wherever it is asked: for 0.14.0 that was between the publish and the push,
# with the crate uploaded, nothing on GitHub and five rebuilt wasm loose in
# the tree.
#
# So it goes last of the things above the prompt, after everything that writes
# to a game repo, because everything above the prompt is undone by git reset
# --hard and nothing below it is.
say "the browser builds, which those commits just put behind"
./build-web
if [ -n "$(git -C blitzkit status --porcelain -- web)" ]; then
  (cd blitzkit && git commit -q -m "Rebuild the browser builds for $want" -- web)
  echo "rebuilt and committed"
else
  echo "nothing moved, so nothing to commit"
fi

# **And then ask the gate the push will ask.** The engine's pre-push is the
# thing that refused 0.14.0, and the push it refuses is at the bottom of this
# file, after the upload. Asked here it costs a few seconds and a git reset
# --hard, and it is the same code either way rather than a second opinion
# about freshness that can come apart from the first.
say "what pre-push will say"
(cd blitzkit && scripts/pre-push)

say "publishing"
echo "This uploads blitzkit $want to crates.io and cannot be undone."
printf 'go ahead? [y/N] '
read -r answer
case "$answer" in
  y | Y | yes | YES) ;;
  *)
    echo "stopped. The bump, the lockfiles, the pictures and the browser builds" >&2
    echo "are committed and nothing is pushed; git reset --hard in each repo" >&2
    echo "undoes all of it." >&2
    exit 1
    ;;
esac
(cd blitzkit && cargo publish)

# After the upload, because a tag left behind by a failed one is worse than no
# tag, and because the games now ask for a version that has to exist.
say "tagging and pushing"
(cd blitzkit && git tag "v$want" && git push -q origin HEAD "v$want")
for repo in "${repos[@]}"; do
  [ "$repo" = "blitzkit" ] && continue
  (cd "$repo" && git push -q)
done
echo "blitzkit v$want and every game"

say "done"
echo "blitzkit $want is published, tagged, and every repo is level."
echo "Look at the thirteen pictures: a staged shot can stage the wrong thing."
