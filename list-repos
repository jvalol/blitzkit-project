#!/usr/bin/env bash
# Every crate in this project, in the order the others should visit them.
#
# This exists because the list used to live in an array in each script, and two
# of them disagreed: securitysweep was in check-all's and never made it into
# check-specs', so the eighth game's specs went unchecked for a day and nothing
# said so. check-listings had already solved this by reading the disk, and this
# is that rule in one place rather than three.
#
# A new game needs no edit here. Clone it into games/ and it is in.
#
# The engine stays beside games/ rather than in it, because the override in
# .cargo/config.toml names that folder.
#
# Usage: ./list-repos [games|shots]
#   (none)  every crate as a path from here, engine first
#   games   the games' names, which is what the readmes and the site write about
#   shots   each game's screenshot, which is what the arcade's build.rs bakes
#
# **shots is here because it was a glob in two other files.** The arcade bakes
# every game's screenshot into its wasm, and `games/*/media/screenshot.png`
# was written out in check-fresh and again in build-web to say which ones.
# That glob matches a directory without a manifest, so it took in aleph, whose
# manifest is Cargo.toml.not-yet: fourteen files hashed to decide whether a
# build holding thirteen was stale. build.rs selects on the manifest being
# there, which is the rule below, so this says it the one way.

set -uo pipefail
cd "$(dirname "$0")" || exit 1

want=${1:-all}

# Names, not paths: a game's name is what the readmes and the site write about.
games() {
  for dir in games/*/; do
    repo=$(basename "$dir")
    # anything without a manifest is not a crate at all
    [ -f "games/$repo/Cargo.toml" ] || continue
    echo "$repo"
  done
}

case "$want" in
  games) games ;;
  shots) games | sed 's|^|games/|; s|$|/media/screenshot.png|' ;;
  all)
    # The engine first, because the games build against the checkout and a
    # failure in it explains theirs.
    echo blitzkit
    # blitzkit/shapes is a workspace member of the engine rather than a repo of
    # its own: the teapot and the Klein bottle are objects the examples draw,
    # not engine code, but their tests have to keep running and a test under
    # examples/ never does. Named separately so its failures are named too.
    [ -f blitzkit/shapes/Cargo.toml ] && echo blitzkit/shapes
    # capriccio is the building the games sit in rather than one of them, so
    # it is beside games/ and not under it. It is a crate and wants testing; it
    # is not a game and must not be asked for a bullet in the game lists.
    #
    # The folder and the binary are capriccio and the room you land in is still
    # an arcade, which is deliberate: the name is the building's and the hall
    # keeps its own sign. What the site serves is still called arcade, so the
    # published name and the crate are two different things and ./build-web is
    # where that is written down.
    [ -f capriccio/Cargo.toml ] && echo capriccio
    games | sed 's|^|games/|'
    ;;
  *)
    echo "usage: $0 [games|shots]" >&2
    exit 2
    ;;
esac
