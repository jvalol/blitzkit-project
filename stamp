#!/usr/bin/env bash
# Write down what a derived thing was made from.
#
# The clips, the stills and the browser builds are all made from the engine
# and all of them drift out of date silently. Nothing in the gate could see
# it: ./check-listings asks whether a thing exists and is mentioned, never
# whether it is current, so on 2026-10-16 every clip and every browser build
# was a day behind the engine and the published arcade was missing a whole
# room.
#
# The naive check is worse than none. "The engine changed" is one date for the
# whole of blitzkit/src, so a change to sound.rs marks the teapot's clip stale
# along with the other ten; a check that always fails is one you learn to
# ignore. So this records a commit per artefact and ./check-fresh reports the
# gap, which is a number you can act on or shrug at rather than an alarm.
#
# What would make it a real check rather than a report is a staged shot you
# can take twice and get the same bytes from. Two staged shots of the same
# scene came out 650640 and 648292 bytes, because what is staged keeps moving
# with the clock, so there is no comparing to be done until the clock is
# pinned. See spec 0056.
#
# **It is the clock and not the thing being filmed.** Written down because
# it was got wrong on 2026-11-02, in a commit message that said the
# arcade's cube seeds itself afresh each take. It does not: `Toy::new`
# sets 0x5eed and the scramble comes off an LCG, so two fresh toys turn
# the same twenty-five faces. The same two timestamps pulled out of two
# takes show the cube in the same state and the camera a few centimetres
# apart, and that offset is the whole of the difference between them.
#
# Pinning the clock would not be enough on its own either. The recording
# samples the screen thirty times a second against a window on vsync, so
# the phase between the two drifts however the game steps. Identical bytes
# need frames written to files rather than filmed off a screen, which
# nothing in the engine can do.
#
# **An artefact is made from two things, not one.** The engine is in all of
# them, and anything that is not an example has a repo of its own on top of
# that. The first version of this recorded only the engine, which meant the
# arcade's browser build could be a day of work out of date and report as
# level: the arcade is not an example, so nothing it owns was being counted.
# That is the exact failure this was written to stop, so it is written down
# here rather than only fixed.
#
# **And one of them is made from three.** The arcade's browser build bakes
# every game's media/screenshot.png into the wasm through its build.rs,
# because a browser has no disk to read them off. So retaking any one of
# thirteen screenshots makes the published arcade stale, and neither commit
# above can see it: both count inside one repo and this crosses thirteen.
# It cost nine commits during the 0.15.0 release from the other end, where
# the same files are inside the hall's picture. Spec 0053 fixed that end.
#
# --bakes records a hash of the files rather than a commit, because the
# question here is not how far behind anything is: it is whether the bytes
# that went in are still the bytes on disk, and that has a yes or a no.
#
# Usage: ./stamp <manifest> [--from <repo>] [--bakes <glob>] <file> [<file> ...]
#   paths are relative to the manifest's own directory
#   --from names the repo the thing was built out of, when that is not the
#   engine. Left off for an example, which is the engine's own.
#   --bakes names files carried inside the thing from outside its repo,
#   as one unquoted glob. A dash when there are none.
#
# Usage: ./stamp --inputs
#   the paths in blitzkit that a derived thing is built out of, one a line.
#   Asked for rather than spelled out again, for the reason below.

set -euo pipefail

# **What the engine's artefacts are made from, said once.** This was `src
# examples` here and `src` in ./check-fresh, two lists of one thing, and they
# had already come apart: the shaders are include_str!'d out of res/shaders
# and neither list named them. Four engine commits have changed a shader and
# nothing else under here (51452ed, e5e34b3, 37c6e18, 5800fdc), and every one
# of them changed what every browser build draws while ./check-fresh reported
# all eighteen level with the engine. The water one was 51452ed, today.
#
# Cargo.toml and Cargo.lock are not in it, and that is a hole left open rather
# than one nobody saw. A dependency bump would change every build. But every
# commit in this repo touching those two files and nothing under src or res is
# either a release version bump or packaging metadata (checked: twenty of them,
# 0.8.0 to 0.16.0, plus 94a908e and a10bbad), so naming them would mark all
# eighteen stale over a version string every release and catch a real bump
# never. Add them the first time a bump catches somebody out.
#
# **Except the engine's own tools.** Nothing under src/bin reaches a derived
# thing. Cargo compiles a bin only when it is asked for by name, and
# ./build-web asks for `--example <name>` for an example and for a game
# repo's own default targets otherwise, so no browser build, clip or still
# has ever held a byte of one. Adding src/bin/picture-of.rs on 2026-11-19
# marked all thirty-six browser builds stale, and rebuilding every one of
# them would have produced what was already there. It cost a --no-verify
# push instead, which is the gate being stepped over rather than answered.
inputs() {
  echo src
  echo res
  echo examples
  echo ':(exclude)src/bin'
}

if [ "${1:-}" = --inputs ]; then
  inputs
  exit 0
fi

manifest=$1
shift

from=-
if [ "${1:-}" = --from ]; then
  repo=$2
  shift 2

  at=$(git -C "$repo" rev-parse --short HEAD 2>/dev/null || echo unknown)
  if ! git -C "$repo" diff --quiet 2>/dev/null; then
    at="$at+"
  fi
  from="$(basename "$repo")@$at"
fi

bakes=-
if [ "${1:-}" = --bakes ]; then
  # shellcheck disable=SC2086
  bakes=$(cat $2 2>/dev/null | shasum -a 256 | cut -c1-8)
  [ -z "$bakes" ] && bakes=unknown
  shift 2
fi

engine=$(git -C blitzkit rev-parse --short HEAD 2>/dev/null || echo unknown)
# a dirty tree is not the commit it claims to be, and saying so is cheaper
# than pretending
# shellcheck disable=SC2046
if ! git -C blitzkit diff --quiet -- $(inputs) 2>/dev/null; then
  engine="$engine+"
fi
when=$(date '+%Y-%m-%dT%H:%M')

mkdir -p "$(dirname "$manifest")"
if [ ! -f "$manifest" ]; then
  {
    echo "# What each thing here was made from, and when."
    echo "#"
    echo "# Written by ./stamp, called from ./build-web and ./refresh-examples."
    echo "# Read by ./check-fresh, which reports how far behind each one is."
    echo "#"
    echo "# Two commits, because a thing is made from two. The engine is in all"
    echo "# of them; source is the repo it was built out of when that is not"
    echo "# the engine, and a dash when it is. A + on either means that tree"
    echo "# was dirty, so what was built is not quite that commit."
    echo "#"
    echo "# file	engine	source	made	bakes"
  } > "$manifest"
fi

for file in "$@"; do
  # out with the old line, in with the new
  tmp=$(mktemp)
  grep -v "^$file	" "$manifest" > "$tmp" || true
  printf '%s\t%s\t%s\t%s\t%s\n' "$file" "$engine" "$from" "$when" "$bakes" >> "$tmp"
  # the comments first, then the rest in name order, so a diff is readable
  { grep '^#' "$tmp"; grep -v '^#' "$tmp" | grep -v '^$' | sort; } > "$manifest"
  rm -f "$tmp"
done
