#!/usr/bin/env bash
# Pushes every repo that has work, in the order the others have to see them.
#
# This project is six repos that depend on each other, and a change often lands
# in two of them: the engine grows a thing and a game uses it. Pushed one at a
# time, by hand, there is a window where what is on GitHub does not hold
# together. On 2026-11-15 a shader went into blitzkit and the picture it
# changed was blessed in xanadu, and whichever of the two went first left a
# clean clone of the pair failing one test.
#
# The window cannot be closed. Nothing pushes two repos at once and nobody is
# going to write a server that does. What can be closed is the gap between
# deciding to push and remembering the second one, which is where every one of
# these has actually come from. So this is one command for the lot, in
# dependency order, and it says at the end whether anything is still behind.
#
# **It refuses on a dirty tree rather than pushing round it.** Half a change
# pushed is the fault this is for, and uncommitted work is the commonest way
# to make one: the web bundles get rebuilt, the push is refused by blitzkit's
# own hook, the bundles are committed later and the pair is out of step in
# between. Commit first, then push everything.
#
# **It is not a gate.** Each repo's own pre-push hook is, and they run as they
# always did: the voice check, the site check, the browser builds. Running
# ./check-all here would make a push take minutes and nobody would use it,
# which is the lesson ./check-fresh already writes down.
#
# **With one refusal it answers rather than reports.** blitzkit's hook refuses
# a push whose browser builds are older than the engine, and the answer is the
# same three steps every time: rebuild, commit web/, push again. Any commit to
# the engine's src brings it up, so on a working day it is most of them, and
# doing it by hand is where the second push gets forgotten. Which is the thing
# this whole file is about.
#
# Usage: ./push [<repo> ...]
#   (none)   every repo with commits origin has not got, engine first
#   <repo>   only those, still in dependency order
#
# The order is ./list-repos', which is the disk's, plus this repo last: the
# project root holds the scripts and the readme, and nothing builds against it.
set -uo pipefail
cd "$(dirname "$0")" || exit 1

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then
  # the comment under the shebang, however long it has become. It was
  # `2,32p`, a number nothing was keeping, in a project whose own hook
  # carries a note about exactly that.
  sed -n '2,$ { /^#/!q; s/^# \{0,1\}//; p; }' "$0"
  exit 0
fi

# the engine first, then the games, then here. ./list-repos is the one account
# of which crates there are; `.` is not in it because it is not a crate.
#
# Read with a loop rather than `mapfile`, which is bash 4 and this is a Mac.
repos=()
while IFS= read -r line; do
  repos+=("$line")
done < <(./list-repos)
repos+=(.)

if [ "$#" -gt 0 ]; then
  wanted=()
  for name in "$@"; do
    found=
    for repo in "${repos[@]}"; do
      if [ "$repo" = "$name" ] || [ "$(basename "$repo")" = "$name" ]; then
        wanted+=("$repo")
        found=yes
      fi
    done
    if [ -z "$found" ]; then
      echo "there is no repo called $name here"
      exit 1
    fi
  done
  repos=("${wanted[@]}")
fi

# A crate inside another repo is not a repo: blitzkit/shapes is part of
# blitzkit and has no remote of its own.
has_repo() {
  [ -d "$1/.git" ]
}

ahead_of_origin() {
  git -C "$1" rev-list --count origin/main..main 2>/dev/null || echo 0
}

dirty=0
pushing=()

for repo in "${repos[@]}"; do
  has_repo "$repo" || continue

  if [ -n "$(git -C "$repo" status --porcelain)" ]; then
    echo "  $repo has uncommitted work"
    dirty=$((dirty + 1))
  fi

  if [ "$(ahead_of_origin "$repo")" -gt 0 ]; then
    pushing+=("$repo")
  fi
done

if [ "$dirty" -gt 0 ]; then
  echo
  echo "nothing pushed: commit or put back what is above first, so that what"
  echo "goes out is a whole change rather than half of one."
  exit 1
fi

if [ "${#pushing[@]}" -eq 0 ]; then
  echo "everything is level with origin."
  exit 0
fi

# **What is stale is the hook's question, and this does not ask it again.**
# It reads the hook's own refusal and answers it, so there is no second
# account here of which builds are behind or of what counts as behind. If
# that wording ever changes this stops rather than guessing, which is the
# safe way round: a push nobody rebuilt for is refused, where a rebuild
# nobody needed is minutes.
#
# Every other refusal is left alone. An unsigned string or a site promising
# a version nobody published wants a person, and there is nothing mechanical
# to do about either.
answerable() {
  local log=$1
  local refusal="the browser builds are behind the engine"

  # **And said out loud if it ever stops being the hook's wording.** That
  # line lives in another file, which is a coupling, and the way it breaks
  # is the quiet one: this would simply never answer again and nobody would
  # know why. Checked where it is used rather than held by a check of its
  # own, which is a file to remember on top of a line to remember.
  if ! grep -q "$refusal" blitzkit/scripts/pre-push 2>/dev/null; then
    echo
    echo "   this no longer knows blitzkit's refusal by sight, so it is not"
    echo "   answering it. See scripts/pre-push and the note above."
    return 1
  fi

  grep -q "$refusal" "$log"
}

answered() {
  local repo=$1 at message

  ./build-web || return 1

  at=$(git -C "$repo" rev-parse --short HEAD)
  if git -C "$repo" diff --quiet -- web ':(exclude)web/MADE'; then
    message="Record the browser builds against $at, since the bytes are the ones already there"
  else
    message="Rebuild the browser builds against $at, since that commit moved their bytes"
  fi

  # staged, so that a build for a game that has not had one before is in
  # the commit; then committed by path, so that nothing else anybody had
  # staged goes out with it.
  git -C "$repo" add web || return 1
  git -C "$repo" commit -q -m "$message" -- web || return 1

  echo "   $message"
  echo

  git -C "$repo" push
}

for repo in "${pushing[@]}"; do
  echo "== $repo, $(ahead_of_origin "$repo") to push"

  # **Held rather than streamed**, because whether it is worth reading
  # depends on how this ends. The refusal above names eighteen builds and
  # then gives the command for doing by hand the thing the next line of
  # this does automatically, and printed in a run that goes on to succeed
  # it reads as a failure. So it is kept, and shown only when nobody is
  # going to act on it.
  #
  # The cost is that a push says nothing while its hook runs, which is
  # about fifteen seconds of copy checks. The `==` line above is there
  # before any of it.
  log=$(mktemp)
  git -C "$repo" push > "$log" 2>&1
  pushed=$?

  if [ "$pushed" != 0 ] && answerable "$log"; then
    echo "   the browser builds are older than this commit, so they are being"
    echo "   rebuilt rather than reported."
    echo

    answered "$repo" && pushed=0
  else
    cat "$log"
  fi

  rm -f "$log"

  if [ "$pushed" != 0 ]; then
    echo
    echo "$repo refused. Nothing after it has been pushed, so the order holds:"
    echo "fix that one and run this again."
    exit 1
  fi
done

# **Read back rather than trusted.** A push that printed nothing alarming and
# left the remote somewhere else is the thing CLAUDE.md says never to take on
# faith, and it costs one call a repo to know.
echo
behind=0

for repo in "${repos[@]}"; do
  has_repo "$repo" || continue

  here=$(git -C "$repo" rev-parse HEAD)
  there=$(git -C "$repo" ls-remote origin refs/heads/main 2>/dev/null | cut -f1)

  if [ "$here" != "$there" ]; then
    echo "  $repo is at ${here:0:7} and origin is at ${there:0:7}"
    behind=$((behind + 1))
  fi
done

if [ "$behind" -gt 0 ]; then
  echo
  echo "$behind repo(s) do not match origin."
  exit 1
fi

echo "every repo matches origin."
