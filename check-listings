#!/usr/bin/env bash
# Every example and every game is written about in three places, and adding one
# means remembering all three. Nothing in a cargo run reads prose, so a new
# thing is listed nowhere and everything still passes.
#
# This checks that each is mentioned, and deliberately not how. The shape of a
# sentence is Jake's; whether a thing got left out entirely is a defect.
#
# The lists come from the disk, via ./list-repos, rather than from an array
# here, so a new example or a new game needs no edit to this file. That is the
# same reason the root .gitignore denies by default: a new game should cost
# nothing here.
#
# Usage: ./check-listings

set -uo pipefail
cd "$(dirname "$0")" || exit 1

missing=0

# Where a thing has to be mentioned. The project readme, the engine's readme,
# and the page on the site for that kind of thing.
example_pages=(README.md blitzkit/README.md blitzkit/site/content/docs/examples.md)
game_pages=(README.md blitzkit/README.md blitzkit/site/content/docs/games.md)
site=blitzkit/site/content/docs/games.md

mentions() {
  # a word, not a substring: "cubes" must not be matched by "cubesomething"
  grep -qE "(^|[^a-zA-Z0-9_-])$2([^a-zA-Z0-9_-]|$)" "$1"
}

echo "== examples"
for file in blitzkit/examples/*.rs; do
  [ -e "$file" ] || continue
  name=$(basename "$file" .rs)

  for page in "${example_pages[@]}"; do
    if ! mentions "$page" "$name"; then
      echo "  $page never mentions the $name example"
      missing=$((missing + 1))
    fi
  done
done

echo "== games"
while read -r repo; do
  # a game with no spec marked implemented is not a game yet, it is a spec and a
  # main that prints where to read it. There is nothing to write about and
  # nothing to photograph, and carom sat in that state for a while. The moment
  # one spec says implemented, everything below applies.
  if ! grep -rqx '\*\*Status:\*\* implemented' games/"$repo"/specs/*.md 2>/dev/null; then
    continue
  fi

  for page in "${game_pages[@]}"; do
    if ! mentions "$page" "$repo"; then
      echo "  $page never mentions $repo"
      missing=$((missing + 1))
    fi
  done

  # A game with no picture of it is a game nobody clicks. The site shows the
  # file from raw.githubusercontent, so the check is two halves: the file has
  # to exist in the game's repo, and the entry has to point at it. lantern and
  # securitysweep had neither, and both readmes still read as complete.
  if [ ! -f "games/$repo/media/screenshot.png" ]; then
    echo "  $repo has no media/screenshot.png"
    missing=$((missing + 1))
  fi
  if ! grep -q "jvalol/$repo/main/media/screenshot.png" "$site"; then
    echo "  $site never shows $repo's screenshot"
    missing=$((missing + 1))
  fi
done < <(./list-repos games)

# Every key an example binds, said on the page that teaches that example.
#
# The checks above ask whether a thing is mentioned at all. This asks a
# narrower question about the one page that is a manual: an example that binds
# a key nobody is told about has a feature nobody will find. `rolling` bound O
# to outline what is solid on 2026-10-10 and the page did not say so until
# today, with the gate green throughout, because nothing here read controls.
#
# Still not how it is written, only whether the key appears. Two conventions
# the page writes as words rather than as keys are expanded first, because
# "WASD" and "the arrows" are how anybody would write them and spelling them
# out would be worse prose.
#
# An example may also point at another: "same controls as the teapot, plus M"
# is honest and reads better than repeating six lines, so a section that names
# another example is read together with that example's section.
echo "== controls"
manual=blitzkit/site/content/docs/examples.md

section() {
  awk -v want="## $2" '
    $0 == want { inside = 1; next }
    inside && /^## / { exit }
    inside { print }
  ' "$1"
}

names=$(for file in blitzkit/examples/*.rs; do basename "$file" .rs; done)

for file in blitzkit/examples/*.rs; do
  [ -e "$file" ] || continue
  name=$(basename "$file" .rs)
  said=$(section "$manual" "$name")

  for other in $names; do
    [ "$other" = "$name" ] && continue
    if printf '%s' "$said" | grep -qE "(^|[^a-zA-Z0-9_-])$other([^a-zA-Z0-9_-]|$)"; then
      said="$said
$(section "$manual" "$other")"
    fi
  done

  case "$said" in *WASD*) said="$said W A S D" ;; esac
  case "$said" in *arrow*) said="$said up down left right" ;; esac

  for key in $(grep -oE 'Key::[A-Za-z0-9]+' "$file" | sed 's/^Key:://' | sort -u); do
    # escape quits every one of them and is said once, at the top
    [ "$key" = "Escape" ] && continue
    # Key1 is the 1 key, and the page calls it 1
    word=${key#Key}

    if ! printf '%s' "$said" | grep -qiE "(^|[^a-zA-Z0-9_-])$word([^a-zA-Z0-9_-]|$)"; then
      echo "  $manual never says what $word does in $name"
      missing=$((missing + 1))
    fi
  done
done

# Every picture the site pulls out of a repo, both ways round.
#
# The games loop above is about games, and the arcade is deliberately not one:
# it is the room the games sit in, it lives beside games/ rather than under it,
# and `list-repos games` leaves it out so that nothing asks it for a bullet in
# a game list. The cost of that was invisible until it was looked for. The
# arcade shows four pictures on the site and not one of them was checked by
# anything, `screenshot.png` included.
#
# So this asks the question the games loop cannot: for every repo in the
# project, does every picture the site asks for exist, and is every picture in
# the repo asked for? A file nobody shows is a file nobody will notice going
# stale, and a picture the site asks for and the repo has not got is a broken
# image on a published page.
#
# Only the ones served out of a repo, which is what `raw.githubusercontent`
# marks. The engine's own example pictures are built into the site and come
# off its own /media, so they are a different question and not this one.
echo "== pictures"
docs=(blitzkit/site/content/docs/*.md)
while read -r path; do
  name=$(basename "$path")
  shown=$(grep -ho "jvalol/$name/main/media/[A-Za-z0-9._-]*" "${docs[@]}" |
    sed "s|jvalol/$name/main/||" | sort -u)
  [ -n "$shown" ] || continue

  while read -r picture; do
    [ -n "$picture" ] || continue
    if [ ! -f "$path/$picture" ]; then
      echo "  the site shows $name's $picture, which is not in the repo"
      missing=$((missing + 1))
    fi
  done <<< "$shown"

  for picture in "$path"/media/*; do
    [ -f "$picture" ] || continue
    if ! printf '%s\n' "$shown" | grep -qxF "media/$(basename "$picture")"; then
      echo "  nothing on the site shows $name's media/$(basename "$picture")"
      missing=$((missing + 1))
    fi
  done
done < <(./list-repos all)

if [ "$missing" -eq 0 ]; then
  echo "every example and every game is written about everywhere it should be"
else
  echo "$missing thing(s) went unmentioned"
  exit 1
fi
