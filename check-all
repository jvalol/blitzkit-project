#!/usr/bin/env bash
# Tests and lints the engine and every game built on it, in that order.
#
# Inside this folder the games build against the engine checkout rather than the
# published crate, so an engine change can break them without anyone noticing
# until the game is run. This is the one command that says whether the whole
# project still holds together.

set -uo pipefail
cd "$(dirname "$0")" || exit 1

# The list comes from ./list-repos rather than an array here, so cloning a game
# beside the engine is the whole of adding it. It used to be an array, and the
# copy in check-specs drifted from this one.
repos=()
while read -r repo; do repos+=("$repo"); done < <(./list-repos)
failed=()

# fmt is here because it was not: piece.rs went into tessera in a state rustfmt
# rejects and sat there, and the engine and slider had drifted by 42 hunks and
# 14. Tests and clippy have nothing to say about layout.
# The release build is here because nothing else builds it. cargo test builds a
# test harness, not target/release, so every binary under it can be stale while
# this passes. cascada's was: the pips went in, the gate went green, and the
# thing that ran had no pips in it.
for repo in "${repos[@]}"; do
  echo "== $repo"
  if ! (cd "$repo" && cargo test --quiet && cargo clippy --quiet --all-targets -- -D warnings && cargo fmt --check && cargo build --release --quiet); then
    failed+=("$repo")
  fi
done

# Nothing in a cargo run reads prose, so a copy marker could sit in the readme
# until `cargo publish` carried it to crates.io. It nearly did on 2026-09-26.
echo "== copy markers"
if ! (cd blitzkit && ./scripts/ship-check); then
  failed+=("unclaimed copy")
fi

# ship-check runs from blitzkit's crate root and scans that crate's readme and
# site, which is right for something published standalone and means it never
# looks up here. This readme is public on GitHub and is copy, and it sat with
# two markers in it that nothing would ever have flagged.
if grep -q '\[COPY - Jake\]' README.md; then
  echo "README.md still carries copy markers:"
  grep -n '\[COPY - Jake\]' README.md | sed 's/^/  /'
  failed+=("unclaimed copy in the project readme")
fi

# The two checks above read prose files. Every string a game draws on screen is
# copy too, and lives in Rust rather than markdown, so both of them looked
# straight past two markers sitting in lantern's own readout.
for repo in "${repos[@]}"; do
  for where in "$repo/src" "$repo/README.md"; do
    [ -e "$where" ] || continue
    if grep -rq '\[COPY - Jake\]' "$where"; then
      echo "$where still carries copy markers:"
      grep -rn '\[COPY - Jake\]' "$where" | sed 's/^/  /'
      failed+=("unclaimed copy in $where")
    fi
  done
done

# Every acceptance criterion names the test holding it up, and nothing in a
# cargo run reads a spec, so a renamed test leaves the spec citing a name that
# answers to nothing while still reading as though the behaviour is covered.
echo "== spec citations"
if ! ./check-specs; then
  failed+=("specs cite missing tests")
fi

# Every example and every game is written about in three places, and adding one
# means remembering all three. Nothing in a cargo run reads prose, so a new
# example was listed nowhere and everything still passed.
echo "== listings"
if ! ./check-listings; then
  failed+=("something went unmentioned")
fi

# The tunnel example and slider share an idea and a set of numbers. Nothing in
# either repo can see the other, so this is the only place the two can be held
# to the same story.
echo "== tunnel and slider"
if ! ./check-tunnel; then
  failed+=("tunnel/slider drift")
fi

echo
if [ ${#failed[@]} -eq 0 ]; then
  echo "all ${#repos[@]} crates pass, nothing ships in Claude's words, and the tunnel example matches slider"
else
  echo "failed: ${failed[*]}"
  exit 1
fi
