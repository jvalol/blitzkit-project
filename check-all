#!/usr/bin/env bash
# Tests and lints the engine and every game built on it, in that order.
#
# Inside this folder the games build against the engine checkout rather than the
# published crate, so an engine change can break them without anyone noticing
# until the game is run. This is the one command that says whether the whole
# project still holds together.

set -uo pipefail
cd "$(dirname "$0")" || exit 1

# blitzkit/shapes is a workspace member of the engine rather than a repo of its
# own: the teapot and the Klein bottle are objects the examples draw, not engine
# code, but their tests have to keep running and a test under examples/ never
# does. Listed separately so its failures are named rather than folded in.
repos=(blitzkit blitzkit/shapes pong snake tessera marble slider monalisa)
failed=()

# fmt is here because it was not: piece.rs went into tessera in a state rustfmt
# rejects and sat there, and the engine and slider had drifted by 42 hunks and
# 14. Tests and clippy have nothing to say about layout.
for repo in "${repos[@]}"; do
  echo "== $repo"
  if ! (cd "$repo" && cargo test --quiet && cargo clippy --quiet --all-targets -- -D warnings && cargo fmt --check); then
    failed+=("$repo")
  fi
done

# Nothing in a cargo run reads prose, so a copy marker could sit in the readme
# until `cargo publish` carried it to crates.io. It nearly did on 2026-09-26.
echo "== copy markers"
if ! (cd blitzkit && ./scripts/ship-check); then
  failed+=("unclaimed copy")
fi

# Every acceptance criterion names the test holding it up, and nothing in a
# cargo run reads a spec, so a renamed test leaves the spec citing a name that
# answers to nothing while still reading as though the behaviour is covered.
echo "== spec citations"
if ! ./check-specs; then
  failed+=("specs cite missing tests")
fi

# The tunnel example and slider share an idea and a set of numbers. Nothing in
# either repo can see the other, so this is the only place the two can be held
# to the same story.
echo "== tunnel and slider"
if ! ./check-tunnel; then
  failed+=("tunnel/slider drift")
fi

echo
if [ ${#failed[@]} -eq 0 ]; then
  echo "all ${#repos[@]} crates pass, nothing ships in Claude's words, and the tunnel example matches slider"
else
  echo "failed: ${failed[*]}"
  exit 1
fi
