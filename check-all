#!/usr/bin/env bash
# Tests and lints the engine and every game built on it, in that order.
#
# Inside this folder the games build against the engine checkout rather than the
# published crate, so an engine change can break them without anyone noticing
# until the game is run. This is the one command that says whether the whole
# project still holds together.

set -uo pipefail
cd "$(dirname "$0")" || exit 1

# The list comes from ./list-repos rather than an array here, so cloning a game
# beside the engine is the whole of adding it. It used to be an array, and the
# copy in check-specs drifted from this one.

# **How many rustc at once.** Cargo's default is one per core, which on this
# machine is eighteen, and eighteen linking at once is what has filled its
# memory more than once during a full gate. Sixteen crates go through here one
# after another and each of them builds four ways, so what this costs in
# wall clock is small and what it saves is the machine going under while it
# runs unattended.
#
# Overridable, because the number is this machine's and the script is not.
export CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-4}

# **And a picture test that drew nothing is not a picture test.** A machine
# with no adapter skips every one of them in the project, says so on stderr,
# and passes, which is the one failure here that looks exactly like success.
# cargo swallows stderr from a test that passed, so the gate would never see
# the line even if it looked.
#
# This machine has an adapter. A run of this that cannot find one has gone
# wrong somewhere that matters more than the pictures, so the gate asks for a
# panic instead of a skip and the engine obliges. Spec 0077. Every repo
# inherits it, since the harness they all call is the engine's.
export PICTURES_REQUIRED=1

repos=()
while read -r repo; do repos+=("$repo"); done < <(./list-repos)
failed=()

# fmt is here because it was not: piece.rs went into tessera in a state rustfmt
# rejects and sat there, and the engine and slider had drifted by 42 hunks and
# 14. Tests and clippy have nothing to say about layout.
# The release build is here because nothing else builds it. cargo test builds a
# test harness, not target/release, so every binary under it can be stale while
# this passes. cascada's was: the pips went in, the gate went green, and the
# thing that ran had no pips in it.
for repo in "${repos[@]}"; do
  echo "== $repo"
  if ! (cd "$repo" && cargo test --quiet && cargo clippy --quiet --all-targets -- -D warnings && cargo fmt --check && cargo build --release --quiet); then
    failed+=("$repo")
  fi
done

# Nothing in a cargo run reads prose, so a copy marker could sit in the readme
# until `cargo publish` carried it to crates.io. It nearly did on 2026-09-26.
echo "== copy markers"
if ! (cd blitzkit && ./scripts/ship-check); then
  failed+=("unclaimed copy")
fi

# ship-check runs from blitzkit's crate root and scans that crate's readme and
# site, which is right for something published standalone and means it never
# looks up here. This readme is public on GitHub and is copy, and it sat with
# two markers in it that nothing would ever have flagged.
if grep -q '\[COPY - Jake\]' README.md; then
  echo "README.md still carries copy markers:"
  grep -n '\[COPY - Jake\]' README.md | sed 's/^/  /'
  failed+=("unclaimed copy in the project readme")
fi

# The two checks above read prose files. Every string a game draws on screen is
# copy too, and lives in Rust rather than markdown, so both of them looked
# straight past two markers sitting in lantern's own readout.
for repo in "${repos[@]}"; do
  for where in "$repo/src" "$repo/README.md"; do
    [ -e "$where" ] || continue
    if grep -rq '\[COPY - Jake\]' "$where"; then
      echo "$where still carries copy markers:"
      grep -rn '\[COPY - Jake\]' "$where" | sed 's/^/  /'
      failed+=("unclaimed copy in $where")
    fi
  done
done

# **And whether the copy is his.** The marker above catches a draft nobody
# has touched. It stops catching anything the moment he strikes it, so a page
# he signed off in September and I rewrote in November ships unmarked. The
# signature is of the bytes, so it comes off the moment a character changes.
#
# Global, in ~/.claude/voice, because the three repos that pin the marker
# string each wrote their own copy of that rule and this one is written once.
# Skipped where it is not installed, so this repo still builds on a machine
# that is not his.
echo "== copy Jake has signed"
if [ -x "$HOME/.claude/voice/check-voice" ]; then
  # once per repository rather than once per crate. check-voice works on the
  # git root, and blitzkit/shapes is a workspace member of the engine rather
  # than a checkout of its own, so asking it separately asked the engine
  # twice and reported its nine pages twice over.
  seen=""
  for repo in "." "${repos[@]}"; do
    top=$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null) || continue
    case "$seen" in *"|$top|"*) continue ;; esac
    seen="$seen|$top|"

    if ! (cd "$repo" && "$HOME/.claude/voice/check-voice" > /dev/null 2>&1); then
      (cd "$repo" && "$HOME/.claude/voice/check-voice")
      failed+=("unsigned copy in $repo")
    fi
  done
else
  echo "   no ~/.claude/voice/check-voice here, so nothing was checked"
fi

# Every acceptance criterion names the test holding it up, and nothing in a
# cargo run reads a spec, so a renamed test leaves the spec citing a name that
# answers to nothing while still reading as though the behaviour is covered.
echo "== spec citations"
if ! ./check-specs; then
  failed+=("specs cite missing tests")
fi

# Every example and every game is written about in three places, and adding one
# means remembering all three. Nothing in a cargo run reads prose, so a new
# example was listed nowhere and everything still passed.
echo "== how far behind the derived things are, here and on the site"
# a report rather than a gate. What a clip is made from is the whole engine,
# so any commit to blitzkit/src could have changed every one of them and
# almost never does; a check that fails on every engine commit is a check
# nobody reads. blitzkit/scripts/pre-push is the one that refuses, and only
# about the browser builds, because pushing blitzkit publishes the site.
#
# It also asks what blitzkit.jva.lol is actually handing out, which is the one
# kind of drift nothing in the repo can see: on 2026-10-17 two pushes sat
# cancelled for five hours while everything here agreed with everything else.
# That part costs three seconds and says nothing at all when the site cannot
# be reached, so it is safe to run with no network.
./check-fresh

echo "== listings"
if ! ./check-listings; then
  failed+=("something went unmentioned")
fi

# The tunnel example and slider share an idea and a set of numbers. Nothing in
# either repo can see the other, so this is the only place the two can be held
# to the same story.
echo "== tunnel and slider"
if ! ./check-tunnel; then
  failed+=("tunnel/slider drift")
fi

# A film is raw pixels with nothing in it saying where a frame starts, so the
# two ways it goes wrong both come out as a clip nobody can read rather than
# as an error. Spec 0084.
echo "== films"
if ! ./check-film; then
  failed+=("a film is not frames")
fi

echo
if [ ${#failed[@]} -eq 0 ]; then
  echo "all ${#repos[@]} crates pass, nothing ships in Claude's words, and the tunnel example matches slider"
else
  echo "failed: ${failed[*]}"
  exit 1
fi
