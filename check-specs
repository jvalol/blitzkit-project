#!/usr/bin/env bash
# Every acceptance criterion in a spec names the test that holds it up. Nothing
# in a cargo run reads a spec, so a test can be renamed or deleted and the spec
# goes on citing a name that answers to nothing, which is worse than no
# citation at all: it reads like the behaviour is covered.
#
# Only specs marked implemented are read for dead citations, which makes the
# status field load bearing: a spec left at draft is a spec nothing checks. So
# the status is checked too, from the other side. A draft all of whose tests
# already exist is a spec that was built and never had its one word changed,
# and eight of those were sitting here with ten rotted citations between them.
#
# A template's placeholder names and a superseded spec's dead ones are both
# meant to be there.
#
# A cited name counts as a test if it has a segment ending in "tests", which is
# what separates `system::tests::escape_quits_from_the_menu` from the constants
# and functions specs also mention in backticks.
#
# Both `klein::tests::x` and `blitzkit_shapes::klein::tests::x` are accepted.
# --list never prints the crate, but a spec in a repo holding more than one has
# to say which crate it means.
#
# **And the citation that points the other way.** A spec number written into a
# comment is a thing somebody will go and look up, and nothing checked that
# there was anything to find: the arcade cited a spec 0059 in twelve places
# for days and the gate stayed green. What is checked is the gap in the
# numbering rather than the comment, because a number read out of a comment
# cannot say which repo it means and every game cites the engine bare.

set -uo pipefail
cd "$(dirname "$0")" || exit 1

# The list comes from ./list-repos, which reads the disk. It was an array here
# and it fell behind check-all's by a whole game.
repos=()
while read -r repo; do repos+=("$repo"); done < <(./list-repos)
missing=0

for repo in "${repos[@]}"; do
  # blitzkit/shapes has no specs and is not meant to: it is objects the
  # examples draw. A crate with no specs directory has nothing to check.
  [ -d "$repo/specs" ] || continue

  have=$(
    cd "$repo" || exit
    for pkg in $(cargo metadata --no-deps --format-version 1 2>/dev/null |
      tr '{' '\n' | sed -n 's/.*"name":"\([^"]*\)".*/\1/p' | sort -u); do
      cargo test -p "$pkg" --quiet -- --list 2>/dev/null | sed 's/: test$//' |
        while read -r t; do
          [ -n "$t" ] || continue
          echo "$t"
          echo "${pkg//-/_}::$t"
        done
    done | sort -u
  )

  if [ -z "$have" ]; then
    # a repo whose specs are all drafts has nothing to prove yet, and a new
    # game is exactly that for a while: a spec and a main that prints where to
    # read it. Anything with an implemented spec and no tests is a real
    # failure, which is what this was written for.
    if grep -rqx '\*\*Status:\*\* implemented' "$repo"/specs/*.md 2>/dev/null; then
      echo "  $repo listed no tests at all, so nothing could be checked"
      missing=$((missing + 1))
    fi
    continue
  fi

  # The index is prose that nothing reads, so it goes stale silently: blitzkit
  # sat three specs behind and tessera still described tetrominoes. A missing
  # index counts too, which is how slider passed this check while having none.
  if [ ! -f "$repo/specs/README.md" ]; then
    echo "  $repo has specs and no specs/README.md to index them"
    missing=$((missing + 1))
  else
    for spec in "$repo"/specs/[0-9]*.md; do
      number=$(basename "$spec" | cut -d- -f1)
      if ! grep -q "\[$number\]" "$repo/specs/README.md"; then
        echo "  $repo/specs/README.md does not list $number"
        missing=$((missing + 1))
        continue
      fi

      # and the row agrees with the spec about whether it is a draft. Two
      # places saying the same thing drift, which is the fault this whole
      # file exists for: thirteen rows across three repos said "(draft)"
      # for a spec that said implemented, all six of lantern's among them,
      # and the loop below that catches a stale draft reads the spec's
      # Status and never the row where the answer is written twice.
      #
      # Only the two words it can judge. A Status is prose in several of
      # these on purpose, "reverted the same day, because it took the sun's
      # shadows with it", and a row is free to say what it likes about one
      # of those.
      row=$(grep "\[$number\]" "$repo/specs/README.md")
      status=$(sed -n 's/^\*\*Status:\*\* //p' "$spec" | head -1)

      case "$status" in
      implemented)
        if grep -q '(draft)' <<<"$row"; then
          echo "  $repo/specs/README.md calls $number a draft and the spec says implemented"
          missing=$((missing + 1))
        fi
        ;;
      draft)
        if ! grep -q '(draft)' <<<"$row"; then
          echo "  $repo/specs/README.md does not call $number a draft and the spec does"
          missing=$((missing + 1))
        fi
        ;;
      esac
    done
  fi

  for spec in "$repo"/specs/*.md; do
    grep -qx '\*\*Status:\*\* implemented' "$spec" || continue

    while read -r name; do
      [ -n "$name" ] || continue
      if ! grep -qxF "$name" <<<"$have"; then
        echo "  $spec cites $name, which no test answers to"
        missing=$((missing + 1))
      fi
    done < <(grep -ho '`[a-z_0-9:]*`' "$spec" | tr -d '`' | grep 'tests::' | sort -u)
  done

  # **And the other direction, which nothing was looking in at all.** Every
  # loop above reads a spec and asks whether the tests it names exist. Nothing
  # read the code and asked anything about the spec it names, so a citation to
  # a spec that was never written sits there reading like cover.
  #
  # Twelve places in the arcade cited a spec 0059 that did not exist: the
  # typed field, the caret, the field's leaf litter and the landing's piers
  # and balusters, three separate pieces of work that all took the next number
  # and none of which wrote the file. Found 2026-11-06 by somebody picking the
  # number for 0060 by hand.
  #
  # **What is checked is the hole, not the citation.** Reading a number out of
  # a comment cannot say which repo is meant: the engine's numbers and a
  # game's run over each other, every game cites the engine's bare as a matter
  # of course, and blitzkit has a 0059 of its own, so a check that accepted
  # either would have called the dead citation fine. The thing that is
  # unambiguous is the gap. Three pieces of work took 0059 and wrote no file,
  # and the arcade's specs ran 0058, then 0060.
  #
  # A skipped number is a real thing and has to be sayable, so it is said
  # here. blitzkit has never had an 0040 and nothing of its own points at one.
  skipped="blitzkit 0040"

  numbers=$(basename -a "$repo"/specs/[0-9]*.md 2>/dev/null | cut -c1-4 | sort -u)

  if [ -n "$numbers" ]; then
    first=$(head -1 <<<"$numbers")
    last=$(tail -1 <<<"$numbers")

    for n in $(seq "$((10#$first))" "$((10#$last))"); do
      printf -v want '%04d' "$n"
      grep -qx "$want" <<<"$numbers" && continue
      grep -qw "$repo $want" <<<"$skipped" && continue

      echo "  $repo has no spec $want and has specs either side of it"
      missing=$((missing + 1))
    done
  fi

  # And a number written into the code is a number somebody has to be able to
  # look up. Its own or the engine's, because that is what a game cites; a
  # citation that names another repo outright says so and is left alone.
  theirs=$(basename -a blitzkit/specs/[0-9]*.md 2>/dev/null | cut -c1-4 | sort -u)

  while read -r said; do
    [ -n "$said" ] || continue

    number=${said##* }
    case "$said" in *"'s spec"*) [ "${said%%\'*}" = "the engine" ] || continue ;; esac
    grep -qx "$number" <<<"$numbers" && continue
    grep -qx "$number" <<<"$theirs" && continue

    echo "  $repo cites a spec $number that is nobody's"
    missing=$((missing + 1))
  done < <(grep -rhoE "([a-z]+'s )?[Ss]pec[a-z]* 0[0-9]{3}" "$repo/src" 2>/dev/null | sort -u)

  # And the other way about: a draft every one of whose tests exists is a spec
  # that got built and never had its one word changed.
  #
  # Status is what decides whether the loop above reads a spec at all, so a
  # stale draft is a spec outside this check entirely. Eight of them were:
  # two of the engine's shapes, all five of lantern's and monty's one, with
  # ten citations between them already naming tests that had been renamed
  # away. Nothing said so, because nothing was looking.
  #
  # Only when every one resolves. A spec written before its code cites tests
  # that do not exist yet and is a real draft, which is what blitzkit's 0024
  # is: it says in its own body that it waits for something to need it, and
  # eight of its ten names are things nobody has written.
  #
  # **And "in build" is a draft by another name.** This read the one word and
  # nothing else, so the arcade's 0057 and 0058 sat outside every loop in this
  # file for two days with the gate green: both built, and 0058 describing a
  # riddle you answered by looking when the code had taken to asking you to
  # type. Widening it catches 0057, whose six tests all existed. It does not
  # catch 0058, which named one test nobody ever wrote, and a spec with an
  # unwritten test in it is what a real draft looks like from here.
  #
  # Two words rather than a rule about anything that is not "implemented",
  # because a Status is prose in several of these on purpose.
  # Every loop here decides whether to read a spec at all from its Status
  # line, so a spec without one is outside the whole check and nothing says
  # so. The arcade's 0012 was: a commit meant to read it against the code
  # emptied all 113 lines of it instead, and six days passed with the gate
  # green, the README still indexing it and src/spa.rs still citing it.
  #
  # The line and not its value, because a Status is prose in several of these
  # and deliberately so: "reverted the same day, because it took the sun's
  # shadows with it" says more than one word from a list would. What cannot
  # be allowed is the header going missing altogether.
  for spec in "$repo"/specs/*.md; do
    case "$(basename "$spec")" in README.md | TEMPLATE.md) continue ;; esac
    grep -q '^\*\*Status:\*\*' "$spec" && continue

    if [ -s "$spec" ]; then
      echo "  $spec has no **Status:** line, so nothing here reads it"
    else
      echo "  $spec is empty"
    fi
    missing=$((missing + 1))
  done

  for spec in "$repo"/specs/*.md; do
    case "$(sed -n 's/^\*\*Status:\*\* //p' "$spec" | head -1)" in
    draft | "in build") ;;
    *) continue ;;
    esac

    cited=0
    answered=0
    while read -r name; do
      [ -n "$name" ] || continue
      cited=$((cited + 1))
      grep -qxF "$name" <<<"$have" && answered=$((answered + 1))
    done < <(grep -ho '`[a-z_0-9:]*`' "$spec" | tr -d '`' | grep 'tests::' | sort -u)

    if [ "$cited" -gt 0 ] && [ "$cited" -eq "$answered" ]; then
      echo "  $spec is not marked implemented and every one of its $cited tests exists"
      missing=$((missing + 1))
    fi
  done
done

if [ "$missing" -eq 0 ]; then
  echo "every implemented spec names tests that exist, every spec is indexed,"
  echo "and no number is cited that nobody wrote"
else
  echo "$missing spec problem(s)"
  exit 1
fi
