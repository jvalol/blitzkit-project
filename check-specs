#!/usr/bin/env bash
# Every acceptance criterion in a spec names the test that holds it up. Nothing
# in a cargo run reads a spec, so a test can be renamed or deleted and the spec
# goes on citing a name that answers to nothing, which is worse than no
# citation at all: it reads like the behaviour is covered.
#
# Only specs marked implemented are read for dead citations, which makes the
# status field load bearing: a spec left at draft is a spec nothing checks. So
# the status is checked too, from the other side. A draft all of whose tests
# already exist is a spec that was built and never had its one word changed,
# and eight of those were sitting here with ten rotted citations between them.
#
# A template's placeholder names and a superseded spec's dead ones are both
# meant to be there.
#
# A cited name counts as a test if it is in a module some test lives in, or if
# it has a segment ending in "tests". Either, because the second was the whole
# rule until 2026-11-23 and it only ever saw the usual module name: blitzkit
# keeps the renderer's tests in `renderer::asked`, and twenty-two citations to
# those sat outside every loop in here, one of them naming a test renamed away
# eleven days earlier. The first rule is read off the code and the second is
# kept so that a module whose every test was deleted does not fall out of the
# check along with them.
#
# **And the citation that was never written.** Every loop here reads a spec and
# asks whether the tests it names exist; nothing asked whether a test is named
# by anything, so a criterion could be deleted outright and this stayed green.
# 330 of the project's tests are named by nothing, so this says what has
# moved since the count was last written down and fails on none of it. See
# `most_uncited` for what that costs.
#
# Both `klein::tests::x` and `blitzkit_shapes::klein::tests::x` are accepted.
# --list never prints the crate, but a spec in a repo holding more than one has
# to say which crate it means.
#
# **And the citation that points the other way.** A spec number written into a
# comment is a thing somebody will go and look up, and nothing checked that
# there was anything to find: the arcade cited a spec 0059 in twelve places
# for days and the gate stayed green. What is checked is the gap in the
# numbering rather than the comment, because a number read out of a comment
# cannot say which repo it means and every game cites the engine bare.

set -uo pipefail
cd "$(dirname "$0")" || exit 1

# The list comes from ./list-repos, which reads the disk. It was an array here
# and it fell behind check-all's by a whole game.
#
# **Unless a repo is named, in which case only that one is read.** Every
# package's tests have to be listed to check a citation, and listing them
# means building them, so the whole project is five minutes. A repo's own
# `scripts/ship` cannot pay that for the other five repos it did not touch,
# and until 2026-11-18 it paid nothing instead: capriccio shipped a3db293
# with two citations its own commit had just killed, because ship runs that
# repo's gate and `check-all` is the only thing that ran this.
#
# Named as paths from here, the way `./list-repos` prints them.
repos=()

# **`--strict`, which is the count's teeth on demand.** Without it the count
# below says only what has moved since the mark was written and fails
# nothing, so a run with something to say still comes back green. With it,
# every test no spec names is named, moved or not, and the run fails.
#
# Quiet by default because the number is 350 and a gate that stops you that
# often is a gate people learn to go round. Strict on the whole count and
# not on the change, because a flag named strict that goes quiet on 209
# tests nobody has written a criterion for is the surprising one, and the
# mark alone gives no way to read the backlog, let alone work it down.
strict=
named_a_repo=

for named in "$@"; do
  case "$named" in
  --strict)
    strict=yes
    continue
    ;;
  esac

  if [ ! -d "$named" ]; then
    echo "  no $named here to check"
    exit 1
  fi

  repos+=("$named")
  named_a_repo=yes
done

if [ -z "$named_a_repo" ]; then
  while read -r repo; do repos+=("$repo"); done < <(./list-repos)
fi
missing=0

for repo in "${repos[@]}"; do
  # blitzkit/shapes has no specs and is not meant to: it is objects the
  # examples draw. A crate with no specs directory has nothing to check.
  [ -d "$repo/specs" ] || continue

  # **The packages, and not every name in the metadata.** `--no-deps` asks
  # cargo for the workspace's own packages, and then a sed over the whole
  # document took every `"name"` in it, dependencies included: blitzkit came
  # back as 39 packages, so this looped `cargo test -p ab_glyph`, `-p wgpu`
  # and 36 others, built their test targets, and folded their tests and their
  # doctests into the list below, where no spec here could ever mean one of
  # them. Harmless while nothing read the list the other way round, and not
  # harmless at all once something did.
  #
  # Not a speed fix: warm, the whole project runs in 25 seconds either way.
  # What a cold cache costs has not been measured.
  #
  # A workspace package's metadata carries an `"id"` beginning `path+file`
  # and a dependency's entry carries no id at all, so that is what tells them
  # apart without a JSON parser.
  packages=$(
    cd "$repo" || exit
    cargo metadata --no-deps --format-version 1 2>/dev/null |
      tr '{' '\n' | grep '"id":"path+file' |
      sed -n 's/.*"name":"\([^"]*\)".*/\1/p' | sort -u
  )

  listed=$(
    cd "$repo" || exit
    for pkg in $packages; do
      cargo test -p "$pkg" --quiet -- --list 2>/dev/null | sed 's/: test$//' |
        while read -r t; do
          [ -n "$t" ] || continue
          printf '%s\t%s\n' "${pkg//-/_}" "$t"
        done
    done | sort -u
  )

  # **The ones marked `#[ignore]`, which the count leaves out.** A test
  # nobody runs by default is a tool: this building keeps a pose printer, a
  # carving writer and a picture writer behind that attribute, and they are
  # tests only because `#[test]` is how you run something by hand. Counting
  # them as criteria nobody wrote makes the number say less than it could.
  # Jake's call, 2026-11-23, reading capriccio's 209.
  skipped_tests=$(
    cd "$repo" || exit
    for pkg in $packages; do
      cargo test -p "$pkg" --quiet -- --list --ignored 2>/dev/null | sed 's/: test$//'
    done | grep . | sort -u
  )

  # What a spec may cite: the bare name, and the same with its crate in
  # front, which a repo holding more than one package has to say.
  have=$(awk -F'\t' '{ print $2; print $1 "::" $2 }' <<<"$listed" | sort -u)

  # And the repo's own tests, once each, for counting. A doctest is a page
  # that compiles rather than an acceptance criterion, and an ignored test is
  # a tool, so neither is one of the things a spec is expected to name.
  mine=$(awk -F'\t' '{ print $2 }' <<<"$listed" | grep -v ' - .*(line [0-9]*)$' | sort -u |
    while read -r t; do
      grep -qxF "$t" <<<"$skipped_tests" || echo "$t"
    done)

  # The modules tests actually live in, which is how a citation is told from
  # the constants and functions a spec also writes in backticks.
  #
  # **Derived and not guessed from the name.** This read a `tests` segment,
  # which is the usual module name and not the only one: blitzkit keeps the
  # renderer's behind `renderer::asked`, and twenty-two citations to those in
  # the engine's own specs were outside every loop in this file. A test
  # renamed away in there said nothing, which is the exact rot this script
  # was written to stop.
  holds_tests=$(sed 's/::[^:]*$//' <<<"$mine" | sort -u)

  if [ -z "$have" ]; then
    # a repo whose specs are all drafts has nothing to prove yet, and a new
    # game is exactly that for a while: a spec and a main that prints where to
    # read it. Anything with an implemented spec and no tests is a real
    # failure, which is what this was written for.
    if grep -rqx '\*\*Status:\*\* implemented' "$repo"/specs/*.md 2>/dev/null; then
      echo "  $repo listed no tests at all, so nothing could be checked"
      missing=$((missing + 1))
    fi
    continue
  fi

  # The index is prose that nothing reads, so it goes stale silently: blitzkit
  # sat three specs behind and tessera still described tetrominoes. A missing
  # index counts too, which is how slider passed this check while having none.
  if [ ! -f "$repo/specs/README.md" ]; then
    echo "  $repo has specs and no specs/README.md to index them"
    missing=$((missing + 1))
  else
    for spec in "$repo"/specs/[0-9]*.md; do
      number=$(basename "$spec" | cut -d- -f1)
      if ! grep -q "\[$number\]" "$repo/specs/README.md"; then
        echo "  $repo/specs/README.md does not list $number"
        missing=$((missing + 1))
        continue
      fi

      # and the row agrees with the spec about whether it is a draft. Two
      # places saying the same thing drift, which is the fault this whole
      # file exists for: thirteen rows across three repos said "(draft)"
      # for a spec that said implemented, all six of lantern's among them,
      # and the loop below that catches a stale draft reads the spec's
      # Status and never the row where the answer is written twice.
      #
      # Only the two words it can judge. A Status is prose in several of
      # these on purpose, "reverted the same day, because it took the sun's
      # shadows with it", and a row is free to say what it likes about one
      # of those.
      row=$(grep "\[$number\]" "$repo/specs/README.md")
      status=$(sed -n 's/^\*\*Status:\*\* //p' "$spec" | head -1)

      case "$status" in
      implemented)
        if grep -q '(draft)' <<<"$row"; then
          echo "  $repo/specs/README.md calls $number a draft and the spec says implemented"
          missing=$((missing + 1))
        fi
        ;;
      draft)
        if ! grep -q '(draft)' <<<"$row"; then
          echo "  $repo/specs/README.md does not call $number a draft and the spec does"
          missing=$((missing + 1))
        fi
        ;;
      esac
    done
  fi

  # Which backticked names in a spec are meant to be tests. A name whose
  # module holds tests is one; so is a name written the old way, with a
  # segment ending in `tests`, which keeps a module whose every test was
  # deleted from quietly falling out of the check along with them.
  cites() {
    grep -ho '`[a-z_0-9:]*`' "$1" | tr -d '`' | grep '::' | sort -u |
      while read -r name; do
        case "$name" in *tests::*) echo "$name"; continue ;; esac
        grep -qxF "${name%::*}" <<<"$holds_tests" && echo "$name"
      done
  }

  for spec in "$repo"/specs/*.md; do
    grep -qx '\*\*Status:\*\* implemented' "$spec" || continue

    while read -r name; do
      [ -n "$name" ] || continue
      if ! grep -qxF "$name" <<<"$have"; then
        echo "  $spec cites $name, which no test answers to"
        missing=$((missing + 1))
      fi
    done < <(cites "$spec")
  done

  # **And the test nobody wrote a criterion for.** Every loop above reads a
  # spec and asks whether the tests it names exist. Nothing asked the
  # reverse, so a criterion could be deleted outright and this stayed green:
  # on 2026-11-23 an edit to capriccio's spec 0132 took seven bullets with
  # it, two of them naming tests that still ran, and the check had nothing to
  # say because every citation that was left still resolved.
  #
  # **A ratchet and not a rule.** 330 of the project's tests are named by no
  # spec, 189 of them in capriccio, so a check that demanded one would be
  # answered by somebody writing 330 lines of prose nobody wants to read.
  # What is held instead is today's number per repo: four of them are at
  # nought already and stay there, and the rest may only ever come down. A
  # deleted criterion puts a count up by one wherever it happens, which is
  # the whole of what this is for.
  #
  # The cost is that a new test nobody cites fails the gate. That is the
  # intended cost: this building writes the criterion first and the test
  # after it, and the line to paste is printed rather than left to work out.
  # Today's numbers, 2026-11-23, ignored tests left out of them. A repo
  # missing from here is at nought and has to stay there: cairn, carom,
  # poolhall and slider are, and three more are within two of it.
  most_uncited="
blitzkit 24
capriccio 189
games/cascada 10
games/lantern 16
games/marble 11
games/monty 48
games/pong 1
games/securitysweep 13
games/snake 1
games/starry 2
games/tessera 15
"

  cited_here=$(
    for spec in "$repo"/specs/*.md; do cites "$spec"; done | sort -u
  )
  # A citation may carry its crate in front, so each one counts under that
  # name and under the name with its first segment taken off.
  cited_bare=$(sed -e p -e 's/^[a-z_0-9]*:://' <<<"$cited_here" | sort -u)

  nameless=$(
    while read -r t; do
      [ -n "$t" ] || continue
      grep -qxF "$t" <<<"$cited_bare" || echo "$t"
    done <<<"$mine"
  )

  count=$(grep -c . <<<"$nameless")
  [ -n "$nameless" ] || count=0
  allowed=$(awk -v r="$repo" '$1 == r { print $2 }' <<<"$most_uncited")
  allowed=${allowed:-0}

  # **It says so and it does not fail.** Jake's call, 2026-11-23, told what
  # the other way round would cost: at 209 in capriccio nearly every new test
  # would hold the gate until somebody wrote it a criterion, and a gate that
  # stops you that often is a gate people learn to go round.
  #
  # What it buys is quiet. What it costs is teeth: the deletion this was
  # built for would print these two lines in a run that still came back
  # green, which is how it got through the first time.
  #
  # Only when the number has moved, so a run with nothing to say says
  # nothing, and the table stays the thing the movement is measured from.
  if [ -n "$strict" ]; then
    # **Strict speaks about the count and not about the change.** A flag
    # named strict that goes quiet on 209 tests nobody has written a
    # criterion for is the surprising one, and the mark below says only what
    # has moved, so without this there is no way to read the backlog at all,
    # let alone work it down. Jake's call, 2026-11-23.
    #
    # The exit code only bites when you asked for it by typing the flag.
    if [ "$count" -gt 0 ]; then
      tests=tests
      [ "$count" -eq 1 ] && tests=test

      echo "  $repo has $count $tests no spec names"
      [ "$count" -ne "$allowed" ] && echo "  the mark says $allowed"

      while read -r t; do
        [ -n "$t" ] && echo "      $t"
      done <<<"$nameless"

      echo "  name them in a criterion, or move the mark:  $repo $count"
      missing=$((missing + 1))
    fi
  elif [ "$count" -ne "$allowed" ]; then
    tests=tests
    [ "$count" -eq 1 ] && tests=test

    if [ "$count" -gt "$allowed" ]; then
      echo "  $repo has $count $tests no spec names, where it had $allowed"

      # **The names only while there are few of them.** The mark is a count
      # and not a list, so this cannot say which one moved: it can only say
      # that one did. Printing all of them to make that point buried the
      # test that had just lost its criterion under 209 that never had one.
      #
      # Where a repo is at or near nought, which is four of them and three
      # more within two, the list is the answer and is short enough to read.
      # Everywhere else it is what `--strict` is for.
      if [ "$count" -le 12 ]; then
        while read -r t; do
          [ -n "$t" ] && echo "      $t"
        done <<<"$nameless"
      else
        echo "      too many to list, so this says only that one moved"
        echo "      ./check-specs --strict $repo names them"
      fi
    else
      echo "  $repo is down to $count $tests no spec names, from $allowed"
    fi

    echo "  neither fails this; to move the mark, say here:  $repo $count"
  fi

  # **And the other direction, which nothing was looking in at all.** Every
  # loop above reads a spec and asks whether the tests it names exist. Nothing
  # read the code and asked anything about the spec it names, so a citation to
  # a spec that was never written sits there reading like cover.
  #
  # Twelve places in the arcade cited a spec 0059 that did not exist: the
  # typed field, the caret, the field's leaf litter and the landing's piers
  # and balusters, three separate pieces of work that all took the next number
  # and none of which wrote the file. Found 2026-11-06 by somebody picking the
  # number for 0060 by hand.
  #
  # **What is checked is the hole, not the citation.** Reading a number out of
  # a comment cannot say which repo is meant: the engine's numbers and a
  # game's run over each other, every game cites the engine's bare as a matter
  # of course, and blitzkit has a 0059 of its own, so a check that accepted
  # either would have called the dead citation fine. The thing that is
  # unambiguous is the gap. Three pieces of work took 0059 and wrote no file,
  # and the arcade's specs ran 0058, then 0060.
  #
  # A skipped number is a real thing and has to be sayable, so it is said
  # here. blitzkit has never had an 0040 and nothing of its own points at one.
  skipped="blitzkit 0040"

  numbers=$(basename -a "$repo"/specs/[0-9]*.md 2>/dev/null | cut -c1-4 | sort -u)

  if [ -n "$numbers" ]; then
    first=$(head -1 <<<"$numbers")
    last=$(tail -1 <<<"$numbers")

    for n in $(seq "$((10#$first))" "$((10#$last))"); do
      printf -v want '%04d' "$n"
      grep -qx "$want" <<<"$numbers" && continue
      grep -qw "$repo $want" <<<"$skipped" && continue

      echo "  $repo has no spec $want and has specs either side of it"
      missing=$((missing + 1))
    done
  fi

  # And a number written into the code is a number somebody has to be able to
  # look up. Its own or the engine's, because that is what a game cites; a
  # citation that names another repo outright says so and is left alone.
  theirs=$(basename -a blitzkit/specs/[0-9]*.md 2>/dev/null | cut -c1-4 | sort -u)

  while read -r said; do
    [ -n "$said" ] || continue

    number=${said##* }
    case "$said" in *"'s spec"*) [ "${said%%\'*}" = "the engine" ] || continue ;; esac
    grep -qx "$number" <<<"$numbers" && continue
    grep -qx "$number" <<<"$theirs" && continue

    echo "  $repo cites a spec $number that is nobody's"
    missing=$((missing + 1))
  done < <(grep -rhoE "([a-z]+'s )?[Ss]pec[a-z]* 0[0-9]{3}" "$repo/src" 2>/dev/null | sort -u)

  # And the other way about: a draft every one of whose tests exists is a spec
  # that got built and never had its one word changed.
  #
  # Status is what decides whether the loop above reads a spec at all, so a
  # stale draft is a spec outside this check entirely. Eight of them were:
  # two of the engine's shapes, all five of lantern's and monty's one, with
  # ten citations between them already naming tests that had been renamed
  # away. Nothing said so, because nothing was looking.
  #
  # Only when every one resolves. A spec written before its code cites tests
  # that do not exist yet and is a real draft, which is what blitzkit's 0024
  # is: it says in its own body that it waits for something to need it, and
  # eight of its ten names are things nobody has written.
  #
  # **And "in build" is a draft by another name.** This read the one word and
  # nothing else, so the arcade's 0057 and 0058 sat outside every loop in this
  # file for two days with the gate green: both built, and 0058 describing a
  # riddle you answered by looking when the code had taken to asking you to
  # type. Widening it catches 0057, whose six tests all existed. It does not
  # catch 0058, which named one test nobody ever wrote, and a spec with an
  # unwritten test in it is what a real draft looks like from here.
  #
  # Two words rather than a rule about anything that is not "implemented",
  # because a Status is prose in several of these on purpose.
  # Every loop here decides whether to read a spec at all from its Status
  # line, so a spec without one is outside the whole check and nothing says
  # so. The arcade's 0012 was: a commit meant to read it against the code
  # emptied all 113 lines of it instead, and six days passed with the gate
  # green, the README still indexing it and src/spa.rs still citing it.
  #
  # The line and not its value, because a Status is prose in several of these
  # and deliberately so: "reverted the same day, because it took the sun's
  # shadows with it" says more than one word from a list would. What cannot
  # be allowed is the header going missing altogether.
  for spec in "$repo"/specs/*.md; do
    case "$(basename "$spec")" in README.md | TEMPLATE.md) continue ;; esac
    grep -q '^\*\*Status:\*\*' "$spec" && continue

    if [ -s "$spec" ]; then
      echo "  $spec has no **Status:** line, so nothing here reads it"
    else
      echo "  $spec is empty"
    fi
    missing=$((missing + 1))
  done

  for spec in "$repo"/specs/*.md; do
    case "$(sed -n 's/^\*\*Status:\*\* //p' "$spec" | head -1)" in
    draft | "in build") ;;
    *) continue ;;
    esac

    cited=0
    answered=0
    while read -r name; do
      [ -n "$name" ] || continue
      cited=$((cited + 1))
      grep -qxF "$name" <<<"$have" && answered=$((answered + 1))
    done < <(cites "$spec")

    if [ "$cited" -gt 0 ] && [ "$cited" -eq "$answered" ]; then
      echo "  $spec is not marked implemented and every one of its $cited tests exists"
      missing=$((missing + 1))
    fi
  done
done

if [ "$missing" -eq 0 ]; then
  echo "every implemented spec names tests that exist, every spec is indexed,"
  echo "and no number is cited that nobody wrote"
else
  echo "$missing spec problem(s)"
  exit 1
fi
