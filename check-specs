#!/usr/bin/env bash
# Every acceptance criterion in a spec names the test that holds it up. Nothing
# in a cargo run reads a spec, so a test can be renamed or deleted and the spec
# goes on citing a name that answers to nothing, which is worse than no
# citation at all: it reads like the behaviour is covered.
#
# Only specs marked implemented are read. A template's placeholder names and a
# superseded spec's dead ones are both meant to be there.
#
# A cited name counts as a test if it has a segment ending in "tests", which is
# what separates `system::tests::escape_quits_from_the_menu` from the constants
# and functions specs also mention in backticks.
#
# Both `klein::tests::x` and `blitzkit_shapes::klein::tests::x` are accepted.
# --list never prints the crate, but a spec in a repo holding more than one has
# to say which crate it means.

set -uo pipefail
cd "$(dirname "$0")" || exit 1

# The list comes from ./list-repos, which reads the disk. It was an array here
# and it fell behind check-all's by a whole game.
repos=()
while read -r repo; do repos+=("$repo"); done < <(./list-repos)
missing=0

for repo in "${repos[@]}"; do
  # blitzkit/shapes has no specs and is not meant to: it is objects the
  # examples draw. A crate with no specs directory has nothing to check.
  [ -d "$repo/specs" ] || continue

  have=$(
    cd "$repo" || exit
    for pkg in $(cargo metadata --no-deps --format-version 1 2>/dev/null |
      tr '{' '\n' | sed -n 's/.*"name":"\([^"]*\)".*/\1/p' | sort -u); do
      cargo test -p "$pkg" --quiet -- --list 2>/dev/null | sed 's/: test$//' |
        while read -r t; do
          [ -n "$t" ] || continue
          echo "$t"
          echo "${pkg//-/_}::$t"
        done
    done | sort -u
  )

  if [ -z "$have" ]; then
    # a repo whose specs are all drafts has nothing to prove yet, and a new
    # game is exactly that for a while: a spec and a main that prints where to
    # read it. Anything with an implemented spec and no tests is a real
    # failure, which is what this was written for.
    if grep -rqx '\*\*Status:\*\* implemented' "$repo"/specs/*.md 2>/dev/null; then
      echo "  $repo listed no tests at all, so nothing could be checked"
      missing=$((missing + 1))
    fi
    continue
  fi

  # The index is prose that nothing reads, so it goes stale silently: blitzkit
  # sat three specs behind and tessera still described tetrominoes. A missing
  # index counts too, which is how slider passed this check while having none.
  if [ ! -f "$repo/specs/README.md" ]; then
    echo "  $repo has specs and no specs/README.md to index them"
    missing=$((missing + 1))
  else
    for spec in "$repo"/specs/[0-9]*.md; do
      number=$(basename "$spec" | cut -d- -f1)
      if ! grep -q "\[$number\]" "$repo/specs/README.md"; then
        echo "  $repo/specs/README.md does not list $number"
        missing=$((missing + 1))
      fi
    done
  fi

  for spec in "$repo"/specs/*.md; do
    grep -qx '\*\*Status:\*\* implemented' "$spec" || continue

    while read -r name; do
      [ -n "$name" ] || continue
      if ! grep -qxF "$name" <<<"$have"; then
        echo "  $spec cites $name, which no test answers to"
        missing=$((missing + 1))
      fi
    done < <(grep -ho '`[a-z_0-9:]*`' "$spec" | tr -d '`' | grep 'tests::' | sort -u)
  done
done

if [ "$missing" -eq 0 ]; then
  echo "every implemented spec names tests that exist, and every spec is indexed"
else
  echo "$missing spec problem(s)"
  exit 1
fi
