#!/usr/bin/env bash
# Regenerate the media pictures for every repo that can stage its own shots.
#
# A game's opening frame rarely shows what the game is about, so this does not
# just run a thing and photograph it. A repo opts in by taking a --screenshot
# argument that puts it in the state worth photographing, and this finds those
# repos by reading their source rather than by keeping a list.
#
# A repo with more than one picture on the site says so by answering
# --screenshots with a name and a file per line. Which pictures a game has is
# the game's to know; this only takes them.
#
# macOS only: it photographs a real window, because nothing in the engine
# renders to a file. The window is on screen while this runs.
set -euo pipefail
cd "$(dirname "$0")"

WIDE=1200
SETTLE=${SETTLE:-5}

# How long to wait for a game to answer a question before taking the silence
# as the answer.
ASKED=${ASKED:-2}

# Ask a game which pictures it has, without hanging when it does not know the
# question.
#
# Only the arcade answers --screenshots. Every other game takes an argument it
# does not recognise, ignores it, and opens its window, so this blocked until
# somebody closed that window by hand: the run stopped dead at the first game
# and stayed there, once per game, which is not a thing to leave for whoever
# runs this next. Jake sat closing windows for half an hour before it was
# spotted.
#
# So it is asked in the background and given two seconds. A game that answers
# has answered long before that and exited; a game that opened a window is
# still alive and gets closed from here.
ask_shots() {
  local name=$1 said q waited
  said=$(mktemp)

  "./target/release/$name" --screenshots >"$said" 2>/dev/null &
  q=$!

  waited=0
  while kill -0 "$q" 2>/dev/null && [ "$waited" -lt $((ASKED * 10)) ]; do
    sleep 0.1
    waited=$((waited + 1))
  done

  stop "$q"
  cat "$said"
  rm -f "$said"
}

# End a run, and mean it.
#
# A game that ignores a polite ask leaves `wait` blocking for ever, which is
# the same hang by another road.
stop() {
  kill "$1" 2>/dev/null || true

  local waited=0
  while kill -0 "$1" 2>/dev/null && [ "$waited" -lt 20 ]; do
    sleep 0.1
    waited=$((waited + 1))
  done

  kill -9 "$1" 2>/dev/null || true
  wait "$1" 2>/dev/null || true
}

say() { printf '%s\n' "$*"; }

# Which repos can stage a shot. The disk is the list, as it is for check-all.
staged() {
  while read -r repo; do
    [ -d "$repo/src" ] || continue
    if grep -rqF -- '--screenshot' "$repo/src"; then
      printf '%s\n' "$repo"
    fi
  done < <(./list-repos all)
}

# The window id for a title, via CoreGraphics. There is no shell for this.
window_id() {
  cat > /tmp/blitzkit-window.swift <<SWIFT
import CoreGraphics
import Foundation
let want = (CommandLine.arguments.dropFirst().first ?? "").lowercased()
let on = CGWindowListCopyWindowInfo([.optionOnScreenOnly], kCGNullWindowID) as? [[String: Any]] ?? []
for w in on {
    let name = w[kCGWindowName as String] as? String ?? ""
    let owner = w[kCGWindowOwnerName as String] as? String ?? ""
    if name.lowercased() == want || owner.lowercased() == want {
        print(w[kCGWindowNumber as String] as? Int ?? 0)
        break
    }
}
SWIFT
  swift /tmp/blitzkit-window.swift "$1"
}

wanted=("$@")
if [ ${#wanted[@]} -eq 0 ]; then
  while read -r repo; do wanted+=("$repo"); done < <(staged)
fi

if [ ${#wanted[@]} -eq 0 ]; then
  say "no repo takes --screenshot yet. Nothing to do."
  exit 0
fi

shot=0
for repo in "${wanted[@]}"; do
  name=$(basename "$repo")
  if ! grep -rqF -- '--screenshot' "$repo/src" 2>/dev/null; then
    say "== $name does not take --screenshot, skipped"
    continue
  fi

  say "== $name"
  (cd "$repo" && cargo build --release --quiet)

  # What this one can photograph, asked of the game rather than assumed. A
  # repo that answers --screenshots names a shot and the file it belongs in,
  # one pair a line, and a repo that does not gets the one shot everybody has.
  #
  # Assumed before, and the assumption was media/screenshot.png and nothing
  # else. The arcade publishes four pictures on the site: three were taken by
  # hand once and nothing here could take them again, so a room that changed
  # under them would leave three pictures of a building that no longer
  # existed, published, with every check green.
  shots=$(ask_shots "$name")
  [ -n "$shots" ] || shots=media/screenshot.png

  # Split on the tab by hand, with IFS emptied. Read with the tab as its
  # separator, a shell strips leading whitespace off the line, so a line whose
  # first field is empty loses it and every field shifts up one: the staged
  # shot came out as a shot with a name and no file to put it in, and was the
  # one picture of four that did not get taken.
  #
  # A line with no tab in it at all is a repo that has only the one picture
  # and no name for it, which is every game but the arcade.
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
      *"$(printf '\t')"*)
        want=${line%%"$(printf '\t')"*}
        file=${line#*"$(printf '\t')"}
        ;;
      *)
        want=
        file=$line
        ;;
    esac

    if [ -n "$want" ]; then
      "./target/release/$name" "--screenshot=$want" >/dev/null 2>&1 &
    else
      "./target/release/$name" --screenshot >/dev/null 2>&1 &
    fi
    running=$!
    sleep "$SETTLE"

    id=$(window_id "$name" || true)
    if [ -z "$id" ]; then
      say "   no window called $name came up for ${want:-the staged shot}"
      stop "$running"
      continue
    fi

    raw=$(mktemp -t "$name").png
    screencapture -x -o -l "$id" "$raw"
    sips --resampleWidth "$WIDE" "$raw" --out "$repo/$file" >/dev/null
    rm -f "$raw"
    stop "$running"

    say "   $repo/$file, $WIDE wide"
    shot=$((shot + 1))
  done <<< "$shots"
done

say ""
say "$shot regenerated. Look at them before committing: a staged shot can stage the wrong thing."
