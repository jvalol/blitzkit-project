#!/usr/bin/env bash
# Regenerate the media pictures for every repo that can stage its own shots.
#
# A game's opening frame rarely shows what the game is about, so this does not
# just run a thing and photograph it. A repo opts in by taking a --screenshot
# argument that puts it in the state worth photographing, and this finds those
# repos by reading their source rather than by keeping a list.
#
# A repo with more than one picture on the site says so by answering
# --screenshots with a name and a file per line. Which pictures a game has is
# the game's to know; this only takes them.
#
# **It renders rather than photographs.** It used `screencapture` on a real
# window, which was macOS only, needed a Screen Recording permission the
# shell it runs in may not have, and never came back with the same bytes
# twice: four of the thirteen churned on every release from capture noise
# alone, and the 0.15.0 release died outright because the shell it was
# started in had no grant.
#
# The engine could do this the whole time. Every picture test in the project
# renders a frame with no window and writes it to a file; the line that used
# to be here saying nothing in the engine renders to a file was true when it
# was written and stopped being true on 2026-11-02. `--picture-to` is that,
# handed to every game by `start`. Spec 0079.
#
# No window opens now, so nothing has to be waited for, found by title, or
# killed.
#
# **Two runs give the same bytes for every game but one.** tessera's panel
# labels come out with different antialiasing about a third of the time:
# 349 pixels of 1.1 million, the same words and the same numbers, nothing of
# the board moved. That was still enough to put a picture in the 0.16.0
# release that nobody could tell from the one it replaced. So the engine
# leaves a file alone that already holds the picture, to the same tolerance
# a picture test uses, and this says which ones it left. Spec 0083.
set -euo pipefail
cd "$(dirname "$0")"


# How long to wait for a game to answer a question before taking the silence
# as the answer.
ASKED=${ASKED:-2}

# Ask a game which pictures it has, without hanging when it does not know the
# question.
#
# Only the arcade answers --screenshots. Every other game takes an argument it
# does not recognise, ignores it, and opens its window, so this blocked until
# somebody closed that window by hand: the run stopped dead at the first game
# and stayed there, once per game, which is not a thing to leave for whoever
# runs this next. Jake sat closing windows for half an hour before it was
# spotted.
#
# So it is asked in the background and given two seconds. A game that answers
# has answered long before that and exited; a game that opened a window is
# still alive and gets closed from here.
ask_shots() {
  local name=$1 said q waited
  said=$(mktemp)

  "./target/release/$name" --screenshots >"$said" 2>/dev/null &
  q=$!

  waited=0
  while kill -0 "$q" 2>/dev/null && [ "$waited" -lt $((ASKED * 10)) ]; do
    sleep 0.1
    waited=$((waited + 1))
  done

  stop "$q"
  cat "$said"
  rm -f "$said"
}

# End a run, and mean it.
#
# A game that ignores a polite ask leaves `wait` blocking for ever, which is
# the same hang by another road.
stop() {
  kill "$1" 2>/dev/null || true

  local waited=0
  while kill -0 "$1" 2>/dev/null && [ "$waited" -lt 20 ]; do
    sleep 0.1
    waited=$((waited + 1))
  done

  kill -9 "$1" 2>/dev/null || true
  wait "$1" 2>/dev/null || true
}

say() { printf '%s\n' "$*"; }

# What is in a file, or nothing at all when it is not there yet.
sha() {
  if [ -f "$1" ]; then
    shasum -a 256 "$1" | cut -d' ' -f1
  else
    printf 'not there\n'
  fi
}

# Which repos can stage a shot. The disk is the list, as it is for check-all.
staged() {
  while read -r repo; do
    [ -d "$repo/src" ] || continue
    if grep -rqF -- '--screenshot' "$repo/src"; then
      printf '%s\n' "$repo"
    fi
  done < <(./list-repos all)
}

wanted=("$@")
if [ ${#wanted[@]} -eq 0 ]; then
  while read -r repo; do wanted+=("$repo"); done < <(staged)
fi

if [ ${#wanted[@]} -eq 0 ]; then
  say "no repo takes --screenshot yet. Nothing to do."
  exit 0
fi

shot=0
same=0
for repo in "${wanted[@]}"; do
  name=$(basename "$repo")
  if ! grep -rqF -- '--screenshot' "$repo/src" 2>/dev/null; then
    say "== $name does not take --screenshot, skipped"
    continue
  fi

  say "== $name"
  (cd "$repo" && cargo build --release --quiet)

  # What this one can photograph, asked of the game rather than assumed. A
  # repo that answers --screenshots names a shot and the file it belongs in,
  # one pair a line, and a repo that does not gets the one shot everybody has.
  #
  # Assumed before, and the assumption was media/screenshot.png and nothing
  # else. The arcade publishes four pictures on the site: three were taken by
  # hand once and nothing here could take them again, so a room that changed
  # under them would leave three pictures of a building that no longer
  # existed, published, with every check green.
  shots=$(ask_shots "$name")
  [ -n "$shots" ] || shots=media/screenshot.png

  # Split on the tab by hand, with IFS emptied. Read with the tab as its
  # separator, a shell strips leading whitespace off the line, so a line whose
  # first field is empty loses it and every field shifts up one: the staged
  # shot came out as a shot with a name and no file to put it in, and was the
  # one picture of four that did not get taken.
  #
  # A line with no tab in it at all is a repo that has only the one picture
  # and no name for it, which is every game but the arcade.
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    case "$line" in
      *"$(printf '\t')"*)
        want=${line%%"$(printf '\t')"*}
        file=${line#*"$(printf '\t')"}
        ;;
      *)
        want=
        file=$line
        ;;
    esac

    # What is there now, so this can say afterwards whether it moved. The
    # engine leaves a file alone that already holds the picture, per spec
    # 0083, and a line saying a file was regenerated when it was not is the
    # kind of thing nobody checks twice.
    was=$(sha "$repo/$file")

    # it runs the staging, draws one frame and exits, so there is nothing
    # to wait for and nothing to kill. The size is the engine's
    # PICTURE_SIZE, said there rather than here.
    if [ -n "$want" ]; then
      "./target/release/$name" "--screenshot=$want" --picture-to "$repo/$file" \
        >/dev/null 2>&1 || true
    else
      "./target/release/$name" --screenshot --picture-to "$repo/$file" \
        >/dev/null 2>&1 || true
    fi

    if [ ! -f "$repo/$file" ]; then
      say "   $name drew nothing for ${want:-the staged shot}"
      continue
    fi

    if [ "$(sha "$repo/$file")" = "$was" ]; then
      say "   $repo/$file is already the picture it draws"
      same=$((same + 1))
      continue
    fi

    say "   $repo/$file"
    shot=$((shot + 1))
  done <<< "$shots"
done

# And the games as one picture, for a readme or a page that wants to show
# what is here before it says anything about it.
#
# It goes in the engine's media because that is the folder the site serves
# and the one both readmes link into, and one picture in one place beats a
# copy in each. Built from every game on disc rather than from the ones this
# run touched, and read off ./list-repos rather than a glob: games/aleph has
# a screenshot and is parked, so a glob puts a game nobody ships at the top
# of the readme.
say "== the grid"
shots=()
while read -r name; do
  [ -f "games/$name/media/screenshot.png" ] && shots+=("games/$name/media/screenshot.png")
done < <(./list-repos games)

if [ ${#shots[@]} -eq 0 ]; then
  say "   no screenshots to lay out"
elif ! ./contact-sheet blitzkit/media/games.png "${shots[@]}"; then
  say "   the grid could not be laid out"
else
  # **The one thing in the engine's media made out of other repos**, so it is
  # the one that needs `--bakes`: a sha of the screenshots it is built from.
  # Without it a game could take a new shot and this grid would go on showing
  # the old one with the gate calling it current, which is the fault ./stamp
  # was written for.
  #
  # **And it said fourteen while the lines above said thirteen.** This was the
  # glob `games/*/media/screenshot.png`, which is what the comment above
  # already explains is wrong for choosing the games: it matches aleph, which
  # is parked and has no manifest. So the grid was laid out from thirteen and
  # stamped with a hash of fourteen. ./list-repos, asked the same way
  # check-fresh asks it, so the two cannot disagree about whether this is
  # stale.
  ./stamp blitzkit/media/MADE --bakes "$(./list-repos shots | tr '\n' ' ')" games.png
fi

say ""
if [ "$same" -gt 0 ]; then
  say "$same already right, left alone."
fi
if [ "$shot" -gt 0 ]; then
  say "$shot regenerated. Look at them before committing: a staged shot can stage the wrong thing."
fi
